<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_band_item"
    android:padding="8dp">

    <!-- Band Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/tv_frequency"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="100 Hz"
            android:textColor="@color/electric_cyan"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tv_band_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.0 dB"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:background="@drawable/bg_value_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="2dp" />

    </LinearLayout>

    <!-- Seek Bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp">

        <SeekBar
            android:id="@+id/seek_bar_band"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:maxHeight="3dp"
            android:minHeight="3dp"
            android:progressDrawable="@drawable/progress_equalizer"
            android:thumb="@drawable/thumb_equalizer"
            android:thumbTint="@color/electric_cyan"
            android:splitTrack="false"
            android:paddingVertical="8dp" />

    </FrameLayout>

    <!-- Frequency Range Indicator (Optional - can be removed if not needed) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="2dp"
        android:paddingHorizontal="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="-15 dB"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Center"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:gravity="center" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+15 dB"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:gravity="end" />

    </LinearLayout>

</LinearLayout>