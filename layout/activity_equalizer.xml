<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/near_black"
    android:orientation="vertical">

    <!-- Animated Gradient Top Bar -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/transparent"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/gradient_equalizer">

            <!-- Status Bar Padding -->
            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />

            <!-- Top Bar Content -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingBottom="24dp">

                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:padding="12dp"
                    android:src="@drawable/ic_arrow_back"
                    android:background="?selectableItemBackgroundBorderless"
                    app:tint="@color/white" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Equalizer"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.02"
                        android:shadowColor="#80FFFFFF"
                        android:shadowRadius="4"
                        android:shadowDx="0"
                        android:shadowDy="0" />

                    <TextView
                        android:id="@+id/tv_preset_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Normal"
                        android:textColor="@color/electric_cyan"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_preset_badge"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="2dp" />

                </LinearLayout>

                <View
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true" />

            </RelativeLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Main Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:scrollbars="none"
        android:fadingEdge="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:animateLayoutChanges="true">

            <!-- Equalizer Switch Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:cardPreventCornerOverlap="true"
                android:translationZ="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card_glow">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_equalizer"
                        android:layout_marginEnd="16dp"
                        android:alpha="0.9"
                        app:tint="@color/electric_cyan" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Equalizer"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tv_eq_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ON"
                        android:textColor="@color/electric_cyan"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="12dp"
                        android:visibility="gone" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_equalizer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/electric_cyan"
                        android:trackTint="@color/electric_cyan_alpha"
                        app:thumbTintMode="src_atop"
                        app:trackTintMode="src_atop" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Visualizer Preview (Optional) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/visualizer_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical|center_horizontal"
                    android:padding="8dp">

                    <!-- Visualizer bars will be added programmatically -->

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Tab Layout -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_layout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_tabs"
                app:tabIndicatorColor="@color/electric_cyan"
                app:tabIndicatorHeight="3dp"
                app:tabSelectedTextColor="@color/electric_cyan"
                app:tabTextColor="@color/text_secondary"
                app:tabRippleColor="@color/electric_cyan_alpha"
                app:tabMode="fixed"
                app:tabGravity="fill"
                app:tabPaddingStart="8dp"
                app:tabPaddingEnd="8dp" />

            <!-- Bands Container (Tab 1) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="visible"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Frequency Bands"
                        android:textColor="@color/electric_cyan"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:drawableStart="@drawable/ic_frequency"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/electric_cyan" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:id="@+id/eq_bands_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:animateLayoutChanges="true" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Presets Card (Tab 2) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/presets_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Presets"
                        android:textColor="@color/electric_cyan"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:drawableStart="@drawable/ic_preset"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/electric_cyan" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginBottom="20dp" />

                    <!-- Preset Chips Container -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:fadingEdge="horizontal"
                        android:fadingEdgeLength="32dp">

                        <LinearLayout
                            android:id="@+id/presets_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:paddingVertical="4dp"
                            android:paddingHorizontal="8dp" />

                    </HorizontalScrollView>

                    <!-- Preset Description -->
                    <TextView
                        android:id="@+id/tv_preset_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Normal: Flat response with no enhancement"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:padding="8dp"
                        android:background="@drawable/bg_search" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Effects Card (Tab 3) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/advanced_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Audio Effects"
                        android:textColor="@color/electric_cyan"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:drawableStart="@drawable/ic_effects"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/electric_cyan" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginBottom="20dp" />

                    <!-- Bass Boost -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp"
                        android:padding="12dp"
                        android:background="@drawable/bg_effect_item"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?selectableItemBackground">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_bass"
                            android:layout_marginEnd="16dp"
                            app:tint="@color/electric_cyan" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Bass Boost"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:id="@+id/tv_bass_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Off"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:layout_marginEnd="12dp" />

                        <ImageView
                            android:id="@+id/btn_bass_boost"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_chevron_right"
                            android:padding="8dp"
                            android:background="?selectableItemBackgroundBorderless"
                            app:tint="@color/text_secondary" />

                    </LinearLayout>

                    <!-- Virtualizer -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp"
                        android:padding="12dp"
                        android:background="@drawable/bg_effect_item"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?selectableItemBackground">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_virtualizer"
                            android:layout_marginEnd="16dp"
                            app:tint="@color/electric_cyan" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Virtualizer"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:id="@+id/tv_virtualizer_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Off"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:layout_marginEnd="12dp" />

                        <ImageView
                            android:id="@+id/btn_virtualizer"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_chevron_right"
                            android:padding="8dp"
                            android:background="?selectableItemBackgroundBorderless"
                            app:tint="@color/text_secondary" />

                    </LinearLayout>

                    <!-- Reverb (Coming Soon) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp"
                        android:background="@drawable/bg_effect_item"
                        android:alpha="0.5">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_reverb"
                            android:layout_marginEnd="16dp"
                            app:tint="@color/text_secondary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Reverb"
                            android:textColor="@color/text_secondary"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Soon"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:background="@drawable/bg_soon_badge"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_preset"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Save Custom"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textColor="@color/near_black"
                    app:icon="@drawable/ic_save"
                    app:iconGravity="textStart"
                    app:iconTint="@color/near_black"
                    app:iconPadding="8dp"
                    app:cornerRadius="26dp"
                    app:backgroundTint="@color/electric_cyan"
                    app:rippleColor="@color/electric_cyan_light"
                    android:elevation="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reset"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Reset"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textColor="@color/electric_cyan"
                    app:icon="@drawable/ic_reset"
                    app:iconGravity="textStart"
                    app:iconTint="@color/electric_cyan"
                    app:iconPadding="8dp"
                    app:cornerRadius="26dp"
                    app:backgroundTint="@color/transparent"
                    app:strokeColor="@color/electric_cyan"
                    app:strokeWidth="2dp"
                    app:rippleColor="@color/electric_cyan_alpha"
                    android:elevation="2dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>